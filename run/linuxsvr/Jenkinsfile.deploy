// 首次部署流水线
// 对应 deploy.sh 的完整流程：构建镜像 → 初始化容器 → 配置 config.py → 建库 → migrate → nginx
pipeline {
    agent any

    parameters {
        string(name: 'SITE',             defaultValue: 'dev',              description: '站点标识，如 dev / prod')
        string(name: 'PROJECT',          defaultValue: 'all_system',       description: '项目名')
        string(name: 'DOMAIN',           defaultValue: 'lvyx.cc',          description: '根域名，留空则不生成 SERVER_NAME')
        booleanParam(name: 'HTTPS',      defaultValue: true,               description: '是否启用 HTTPS（影响 CSRF_TRUSTED_ORIGINS 和 nginx 配置）')
        string(name: 'LISTEN',           defaultValue: '80',               description: 'nginx 监听端口')
        string(name: 'HOST_DATA',        defaultValue: '',                 description: '宿主机数据根目录，留空默认 /data/<project>')
        string(name: 'NGINX_RELOAD_DIR', defaultValue: '/home/applications/ng_container', description: 'nginx reload.sh 所在目录')
        booleanParam(name: 'NO_CACHE',   defaultValue: false,              description: 'docker build 时使用 --no-cache')
        booleanParam(name: 'NO_NGINX',   defaultValue: false,              description: '跳过 nginx reload')
    }

    environment {
        SCRIPT_DIR   = "${WORKSPACE}/run/linuxsvr"
        HOST_DATA_RESOLVED = "${params.HOST_DATA ?: '/data/' + params.PROJECT}"
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('参数确认') {
            steps {
                script {
                    def domain = params.DOMAIN ?: '（无）'
                    echo """
========================================
 site    : ${params.SITE}
 project : ${params.PROJECT}
 domain  : ${domain}
 https   : ${params.HTTPS}
 listen  : ${params.LISTEN}
 host_data: ${env.HOST_DATA_RESOLVED}
========================================"""
                }
            }
        }

        stage('构建镜像') {
            steps {
                script {
                    def args = "-s ${params.SITE} -p ${params.PROJECT}"
                    if (params.DOMAIN) args += " -d ${params.DOMAIN}"
                    if (params.NO_CACHE) args += " --no-cache"
                    sh "python3 ${env.SCRIPT_DIR}/build_image.py ${args}"
                }
            }
        }

        stage('初始化部署') {
            steps {
                script {
                    // 找最新产出目录
                    def latestDir = sh(
                        script: "ls -td ${WORKSPACE}/build/[0-9]* 2>/dev/null | head -1",
                        returnStdout: true
                    ).trim()
                    if (!latestDir) error("未找到构建产物目录: ${WORKSPACE}/build")
                    echo "产物目录: ${latestDir}"
                    env.LATEST_DIR = latestDir

                    sh "python3 ${latestDir}/init.py"
                }
            }
        }

        stage('更新 config.py') {
            steps {
                script {
                    def deployConfig = "${env.HOST_DATA_RESOLVED}/${params.SITE}/config.py"
                    def slug = "${params.SITE}-${params.PROJECT}".replace('_', '-')
                    def serverName = params.DOMAIN ? "${slug}.${params.DOMAIN}" : "localhost"
                    def csrfOrigin = params.HTTPS ? "https://${serverName}" : "http://${serverName}"

                    sh """python3 - '${deployConfig}' '${serverName}' '${csrfOrigin}' '${params.PROJECT}' '${params.SITE}' <<'PYEOF'
import sys, re

config_path, server_name, csrf_origin, project, site = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
text = open(config_path, encoding='utf-8').read()

db_name_raw   = '{}_{}'.format(project, site)
allowed_val   = '["{}", "localhost", "127.0.0.1"]'.format(server_name)
csrf_val      = '["{}"]'.format(csrf_origin)
db_name_val   = '"{}"'.format(db_name_raw)
redis_pfx_val = '"{}"'.format(db_name_raw)

def set_var(src, name, value):
    import re
    pattern = r'^' + name + r'\\s*=.*\$'
    new_line = '{}={}'.format(name, value)
    if re.search(pattern, src, re.MULTILINE):
        return re.sub(pattern, new_line, src, flags=re.MULTILINE)
    return src.rstrip('\\n') + '\\n' + new_line + '\\n'

text = set_var(text, 'ALLOWED_HOSTS', allowed_val)
text = set_var(text, 'CSRF_TRUSTED_ORIGINS', csrf_val)
text = set_var(text, 'DB_NAME', db_name_val)
text = set_var(text, 'REDIS_KEY_PREFIX', redis_pfx_val)
open(config_path, 'w', encoding='utf-8').write(text)
print('  ALLOWED_HOSTS={}'.format(allowed_val))
print('  CSRF_TRUSTED_ORIGINS={}'.format(csrf_val))
print('  DB_NAME={}'.format(db_name_val))
print('  REDIS_KEY_PREFIX={}'.format(redis_pfx_val))
PYEOF"""
                }
            }
        }

        stage('创建数据库') {
            steps {
                script {
                    def deployConfig = "${env.HOST_DATA_RESOLVED}/${params.SITE}/config.py"
                    def dbName = "${params.PROJECT}_${params.SITE}"
                    sh """python3 - '${deployConfig}' '${dbName}' <<'PYEOF'
import sys, re, subprocess

config_path, db_name = sys.argv[1], sys.argv[2]
text = open(config_path, encoding='utf-8').read()

def get_var(src, name, default=''):
    m = re.search(r'^' + name + r'\\s*=\\s*["\\'\\']?(.*?)["\\'\\']?\\s*\$', src, re.MULTILINE)
    return m.group(1).strip() if m else default

host     = get_var(text, 'DB_HOST', '127.0.0.1')
port     = get_var(text, 'DB_PORT', '3306')
user     = get_var(text, 'DB_USER', 'root')
password = get_var(text, 'DB_PASSWORD', '')

sql = 'CREATE DATABASE IF NOT EXISTS `{}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;'.format(db_name)
cmd = ['mysql', '-h{}'.format(host), '-P{}'.format(port), '-u{}'.format(user), '-p{}'.format(password), '-e', sql]
print('\$ mysql -h{} -P{} -u{} -p*** -e "{}"'.format(host, port, user, sql))
result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True)
if result.returncode != 0:
    print(result.stderr, file=sys.stderr)
    sys.exit(result.returncode)
print('  数据库 `{}` 已就绪'.format(db_name))
PYEOF"""
                }
            }
        }

        stage('Migrate') {
            steps {
                script {
                    def containerName = "${params.PROJECT}_${params.SITE}"
                    // 等待容器就绪
                    sh """
for i in \$(seq 1 15); do
    docker exec ${containerName} python manage.py check --database default > /dev/null 2>&1 && break
    sleep 2
done
"""
                    sh "docker exec ${containerName} python manage.py makemigrations"
                    sh "docker exec ${containerName} python manage.py migrate"
                    sh "docker exec ${containerName} python manage.py init"
                    sh """docker exec \
    -e DJANGO_SUPERUSER_USERNAME=admin \
    -e DJANGO_SUPERUSER_PASSWORD=123456 \
    -e DJANGO_SUPERUSER_EMAIL=admin@admin.com \
    ${containerName} \
    python manage.py createsuperuser --noinput 2>&1 | grep -v 'already exists' || true"""
                }
            }
        }

        stage('生成 nginx 配置') {
            steps {
                script {
                    def httpsFlag = params.HTTPS ? '--https' : '--no-https'
                    sh "python3 ${env.LATEST_DIR}/register_nginx.py --listen ${params.LISTEN} ${httpsFlag}"
                }
            }
        }

        stage('重载 nginx') {
            when {
                expression { !params.NO_NGINX }
            }
            steps {
                script {
                    def reloadScript = "${params.NGINX_RELOAD_DIR}/reload.sh"
                    sh """
if [ -f '${reloadScript}' ]; then
    bash '${reloadScript}'
else
    echo '未找到 ${reloadScript}，跳过 nginx 重载' >&2
fi
"""
                }
            }
        }

        stage('保存配置') {
            steps {
                script {
                    def savedConfig = "${env.HOST_DATA_RESOLVED}/${params.SITE}/build.json"
                    sh """python3 - '${savedConfig}' '${params.SITE}' '${params.PROJECT}' '${params.DOMAIN}' '${params.HTTPS}' '${params.LISTEN}' '${params.NGINX_RELOAD_DIR}' '${env.HOST_DATA_RESOLVED}' <<'PYEOF'
import sys, json
path, site, project, domain, https, listen, nginx_dir, host_data = sys.argv[1:]
data = {
    'site': site, 'project': project, 'domain': domain,
    'https': https.lower() == 'true', 'listen': int(listen),
    'nginx_reload_dir': nginx_dir, 'host_data': host_data,
}
json.dump(data, open(path, 'w', encoding='utf-8'), ensure_ascii=False, indent=2)
print('  配置已保存至: {}'.format(path))
PYEOF"""
                }
            }
        }
    }

    post {
        success {
            echo "======== 部署完成 ========"
        }
        failure {
            echo "======== 部署失败，请检查日志 ========"
        }
    }
}
